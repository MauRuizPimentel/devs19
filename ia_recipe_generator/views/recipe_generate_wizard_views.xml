<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="recipe_generate_wizard_view_form" model="ir.ui.view">
        <field name="name">recipe.generate.wizard.view.form</field>
        <field name="model">recipe.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Recipe">
                <group>
                    <field name="food_name" placeholder="e.g. huevos, frijoles"/>
                </group>
                <footer>
                    <button name="action_generate_recipe" string="Generate" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="recipe_generate_wizard_action" model="ir.actions.act_window">
        <field name="name">Generate Recipe</field>
        <field name="res_model">recipe.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_recipe_generate"
        name="Generate Recipe"
        parent="menu_recipe_root"
        action="recipe_generate_wizard_action"
        sequence="20"/>
</odoo>
