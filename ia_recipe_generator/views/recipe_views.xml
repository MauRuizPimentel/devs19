<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="recipe_recipe_view_list" model="ir.ui.view">
        <field name="name">recipe.recipe.view.list</field>
        <field name="model">recipe.recipe</field>
        <field name="arch" type="xml">
            <list string="Recipes">
                <field name="name"/>
                <field name="preparation_time"/>
                <field name="difficulty"/>
                <field name="image" invisible="1"/>
                <field name="instructions" invisible="1"/>
                <field name="id" widget="recipe_preview_button" string="Preview"/>
            </list>
        </field>
    </record>

    <record id="recipe_recipe_action_list" model="ir.actions.act_window">
        <field name="name">Recipes</field>
        <field name="res_model">recipe.recipe</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_recipe_root"
        name="Recipes"
        sequence="100"/>
    <menuitem
        id="menu_recipe_list"
        name="Recipes"
        parent="menu_recipe_root"
        action="recipe_recipe_action_list"
        sequence="10"/>
</odoo>
