<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gps_coordinate_view_list" model="ir.ui.view">
        <field name="name">gps.coordinate.view.list</field>
        <field name="model">gps.coordinate</field>
        <field name="arch" type="xml">
            <list string="Recorridos" default_order="recorded_at desc" create="false">
                <field name="vehicle_id"/>
                <field name="recorded_at"/>
                <field name="latitude"/>
                <field name="longitude"/>
            </list>
        </field>
    </record>

    <record id="gps_coordinate_view_search" model="ir.ui.view">
        <field name="name">gps.coordinate.view.search</field>
        <field name="model">gps.coordinate</field>
        <field name="arch" type="xml">
            <search string="Recorridos">
                <field name="vehicle_id"/>
                <field name="recorded_at"/>
                <filter string="Vehículo" name="group_by_vehicle" context="{'group_by': 'vehicle_id'}"/>
            </search>
        </field>
    </record>

    <record id="gps_coordinate_action" model="ir.actions.act_window">
        <field name="name">Recorridos</field>
        <field name="res_model">gps.coordinate</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
