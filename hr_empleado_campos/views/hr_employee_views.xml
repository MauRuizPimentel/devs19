<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_nuevos_campos" model="ir.ui.view">
        <field name="name">hr.employee.form.nuevos.campos</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="nuevos_campos" string="Nuevos campos">
                    <group>
                        <group>
                            <field name="curp"/>
                            <field name="cat_puesto_id"/>
                            <field name="modalidad"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
